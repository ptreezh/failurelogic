# Railway配置文件
# 用于部署认知陷阱平台API后端

[build]
builder = "NIXPACKS"

[nixpacks]
phases = {
  setup = {
    nixPkgs = ["python310", "nodejs-18_x", "gcc", "libffi", "openssl"]
  },
  install = {
    cmd = [
      "pip install --upgrade pip",
      "pip install -r requirements.txt"
    ]
  },
  start = {
    cmd = [
      "cd api-server && python minimal_api_test.py"
    ]
  }
}

[deploy]
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 3

# 环境变量
[variables]
PORT = "8080"
